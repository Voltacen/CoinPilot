# .env.example

# Flask
SECRET_KEY=dev-secret-key
JWT_SECRET_KEY=dev-jwt-secret
FLASK_ENV=development

# Postgres
POSTGRES_PASSWORD=coinpilot
DATABASE_URL=postgresql://coinpilot:coinpilot@db:5432/coinpilot

# Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Playwright
# If running Playwright service separately you can supply path
PLAYWRIGHT_CHROMIUM_PATH=

# Admin demo supply
DEFAULT_ADMIN_CREDIT_SUPPLY=879877879
