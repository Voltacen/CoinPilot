# Flask Core
FLASK_APP=wsgi.py
FLASK_ENV=production
SECRET_KEY=generate_with_python_secrets_token_hex_32

# Persistence
DATABASE_URL=postgresql://coinpilot_user:secure_password@localhost:5432/coinpilot_db
TEST_DATABASE_URL=sqlite:///:memory:

# Security & Limits
RATELIMIT_STORAGE_URI=memory://
SESSION_COOKIE_SECURE=True
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax
 Strict=true 
# EVM Testnet RPC Endpoints
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Platform Hot Wallet for Testnet Dispatch (Hex string without 0x or with 0x)
# DO store mainnetnetnnet keys here.
PLATFORM_TESTNET_SIGNER_KEY=

# Initial Bootstrap
ADMIN_EMAIL=admin@coinpilot.internal
ADMIN_INITIAL_PASSWORD=
ADMIN_BOOTSTRAP_TOKEN=
